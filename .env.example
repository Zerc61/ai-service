# =====================================================================
# EJT AI Core — Konfigurasi Environment
# Salin sebagai `.env` lalu isi nilai yang sesuai.
# =====================================================================

# --- Identitas ---
APP_NAME=EJT AI Core
APP_VERSION=2.0.0

# --- Embedding (LOKAL, gratis, tanpa API key) ---
# local  = BAAI/bge-small-en-v1.5 via sentence-transformers (default produksi)
# hash   = deterministik, HANYA untuk test / fallback (bukan produksi)
EMBEDDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# --- Vector store ---
# memory = store numpy lokal (opsional persist file) — bagus untuk MVP/test
# qdrant = Qdrant (URL kosong / ':memory:' = mode memory; isi URL utk server)
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_COLLECTION=ejt_destinations
# Path persistensi optional untuk VECTOR_STORE=memory (kosongkan utk tidak persist)
VECTOR_PERSIST_PATH=

# --- LLM (Groq) ---
# groq = produksi (wajib GROQ_API_KEY)
# fake = test / tanpa jaringan
LLM_PROVIDER=groq
GROQ_API_KEY=
# Model default Master Plan: llama-3.3-70b-versatile.
# Jika akun tidak punya akses model tsb, ganti ke model yang tersedia
# (mis. qwen/qwen3.8-27b, gemma2-9b-it).
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024

# --- Keamanan server-to-server (Laravel <-> FastAPI) ---
# Wajib diisi; dikirim header `X-AI-Secret` dari Laravel.
SHARED_SECRET=

# --- RAG tuning ---
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0

# --- Smart Trip Planner ---
TRIP_DEFAULT_BUDGET=0.0
